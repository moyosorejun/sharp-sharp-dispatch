# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase: Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key

# Vapi: Dashboard > API Keys (use the PRIVATE key)
VAPI_API_KEY=your-vapi-private-key

# Public URL of this server. Use your free static ngrok domain so it never changes:
#   ngrok http --url=your-name.ngrok-free.app 3001
PUBLIC_SERVER_URL=https://your-name.ngrok-free.app

# Leave empty on the first `npm run create-assistant`, then paste the id it prints.
# With it set, the script updates that assistant instead of creating a new one.
VAPI_ASSISTANT_ID=

# Optional: shared secret so only Vapi can call /vapi
VAPI_SERVER_SECRET=pick-a-long-random-string

# Optional until Day 4: n8n webhook that sends you the WhatsApp/email alert
N8N_WEBHOOK_URL=

# Which LLM Vapi should use (check the model list in the Vapi dashboard)
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o

# Voice: pick a Nigerian-accent voice in the Vapi dashboard and paste its provider + id here
VOICE_PROVIDER=11labs
VOICE_ID=paste-voice-id-here

PORT=3001

# Web app origin(s) allowed to call the read-only /api routes (comma separated)
WEB_ORIGIN=http://localhost:5173
